# NexAi-PSICO - Variáveis de Ambiente

# Configurações do Google Gemini AI (Opcional para testes - o app possui fallback automático de alta fidelidade)
VITE_GEMINI_API_KEY=

# Configurações do Firebase (Opcional - o app funciona em modo offline/local se não fornecido)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Configuração da Pasta Raiz do Google Drive (ID da pasta no Google Drive)
VITE_GOOGLE_DRIVE_ROOT_FOLDER_ID=

# URL da Cloud Function do Backend (se implantado)
VITE_BACKEND_API_URL=http://localhost:5001/nexai-psico/us-central1
