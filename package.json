{
  "name": "nexai-psico",
  "private": true,
  "version": "1.0.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "node scripts/release.js",
    "release": "node scripts/release.js",
    "release:minor": "node scripts/release.js --minor",
    "release:major": "node scripts/release.js --major",
    "deploy:hosting": "npm run build && npx -y firebase-tools deploy --only hosting",
    "git:sync": "git add -A && git commit -m \"sync: automatic backup to github\" && git push origin main"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.16.0",
